# Neon Postgres connection string (Neon console -> Connect). Use the pooled URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth base URL (Neon console -> Auth -> Configuration)
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# Random secret, at least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
